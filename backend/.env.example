# Copy to .env and fill in real values. Never commit .env.
#
# ── Online Supabase ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
SUPABASE_URL=https://<REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
#
# ── Local Supabase (uncomment these, comment out online values above) ─
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54324/postgres
# SUPABASE_URL=http://127.0.0.1:54323
# SUPABASE_SERVICE_ROLE_KEY=
#
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
RESET_TOKEN_TTL=15m
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
GOOGLE_CLIENT_ID=
PORT=3000
SUPABASE_AUDIO_BUCKET=audio
SUPABASE_COVERS_BUCKET=covers
